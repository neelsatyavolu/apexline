{
  "name": "apexline",
  "version": "1.1.11",
  "private": true,
  "license": "MIT",
  "description": "Apexline macOS F1 companion app",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "node scripts/build-renderer.cjs",
    "screenshot:site": "node scripts/build-renderer.cjs && electron scripts/capture-site-screenshots.cjs",
    "icon:app": "node scripts/generate-app-icon.cjs",
    "package:mac": "node scripts/build-renderer.cjs && node scripts/package-macos.cjs",
    "package:mac:vmp": "node scripts/build-renderer.cjs && PITWALL_CASTLABS_VMP=1 node scripts/package-macos.cjs",
    "package:mac:signed": "bash scripts/release-macos.sh --no-notarize --skip-feed",
    "package:mac:release": "bash scripts/release-macos.sh --skip-feed",
    "release:mac": "bash scripts/release-macos.sh",
    "release:update-feed": "node scripts/prepare-vercel-update.cjs",
    "start": "node scripts/build-renderer.cjs && electron .",
    "dev": "electron .",
    "test": "node scripts/pitwall-smoke-test.cjs && node scripts/social-api-smoke-test.cjs && node scripts/openf1-proxy-smoke-test.cjs",
    "smoke": "node scripts/pitwall-smoke-test.cjs",
    "probe:openf1:monaco": "node scripts/pitwall-openf1-replay-probe.cjs --meeting=1286 --session=Qualifying --elapsed=861",
    "probe:f1timing:monaco": "node scripts/pitwall-f1timing-replay-probe.cjs --elapsed=3600",
    "probe:trackmap:monaco-race": "node scripts/trackmap-replay-render-probe.cjs --elapsed=300",
    "probe:trackmap:z-anchor": "node scripts/trackmap-z-anchor-probe.cjs",
    "probe:live-layout": "node scripts/build-renderer.cjs && electron scripts/live-racing-layout-probe.cjs",
    "probe:theater": "node scripts/build-renderer.cjs && electron scripts/theater-replay-render-probe.cjs"
  },
  "dependencies": {
    "@babel/standalone": "^7.29.0",
    "@neelsatyavolu/shared-ai-auth": "https://codeload.github.com/neelsatyavolu/shared-ai-auth/tar.gz/c1e7c0ac87717d27bc33f591795e37175ce02ee6",
    "@vercel/postgres": "^0.10.0",
    "hls.js": "^1.6.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shaka-player": "^5.1.7"
  },
  "devDependencies": {
    "electron": "github:castlabs/electron-releases#v39.1.0+wvcus"
  },
  "apexline": {
    "updateBaseUrl": "https://apexline.io",
    "bundleId": "io.apexline.app"
  },
  "pitwall": {
    "updateBaseUrl": "https://apexline.io"
  }
}
