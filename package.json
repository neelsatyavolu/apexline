{
  "name": "pitwall",
  "version": "0.1.0",
  "private": true,
  "description": "PitWall macOS F1 companion prototype",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "node scripts/build-renderer.cjs",
    "package:mac": "node scripts/build-renderer.cjs && node scripts/package-macos.cjs",
    "package:mac:vmp": "node scripts/build-renderer.cjs && PITWALL_CASTLABS_VMP=1 node scripts/package-macos.cjs",
    "start": "node scripts/build-renderer.cjs && electron .",
    "dev": "electron .",
    "test": "node scripts/pitwall-smoke-test.cjs",
    "smoke": "node scripts/pitwall-smoke-test.cjs",
    "probe:openf1:monaco": "node scripts/pitwall-openf1-replay-probe.cjs --meeting=1286 --session=Qualifying --elapsed=861",
    "probe:f1timing:monaco": "node scripts/pitwall-f1timing-replay-probe.cjs --elapsed=3600"
  },
  "dependencies": {
    "@babel/standalone": "^7.29.0",
    "hls.js": "^1.6.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shaka-player": "^5.1.7"
  },
  "devDependencies": {
    "electron": "github:castlabs/electron-releases#v39.1.0+wvcus"
  }
}
